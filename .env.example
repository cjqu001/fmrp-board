# Copy to .env and fill in. Never commit .env.
# Generate a secret key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Admin login (Quinones only): can undo changes from the change log
ADMIN_NAME=Quinones
ADMIN_PASSWORD=change-me

# Shared editor password for residents; each person types their name at login
EDITOR_PASSWORD=change-me

# Changing a password: edit it here, then restart the container. The app updates the stored hash on start.
